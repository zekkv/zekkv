{
  "name": "my-portfolio",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "bun run build && wrangler dev",
    "test": "vitest run",
    "lint:check": "oxlint --quiet",
    "format:check": "oxfmt --check",
    "lint:fix": "oxlint --fix",
    "format:fix": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install || true",
    "clean": "bunx rimraf node_modules .tanstack .vercel dist .turbo",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@sentry/cloudflare": "11.8.0",
    "@sentry/tanstackstart-react": "^11.8.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "@upstash/redis": "^1.39.0",
    "next-themes": "0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
