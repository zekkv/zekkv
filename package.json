{
  "name": "my-portfolio",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "bun run build && wrangler dev",
    "test": "vitest run",
    "lint:check": "oxlint --quiet",
    "format:check": "oxfmt --check",
    "lint:fix": "oxlint --fix",
    "format:fix": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install || true",
    "clean": "bunx rimraf node_modules .tanstack .vercel dist .turbo",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@sentry/cloudflare": "10.71.0",
    "@sentry/tanstackstart-react": "^11.8.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@upstash/redis": "^1.38.3",
    "next-themes": "0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
