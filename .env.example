# Strapi CMS (server-only — no VITE_ prefix)
STRAPI_URL=https://strapi.ciav.dev
STRAPI_API_TOKEN=
# Shared secret checked against the `x-webhook-secret` header — set the same value
# as a custom header on the webhook in Strapi Admin → Settings → Webhooks
STRAPI_WEBHOOK_SECRET=

# Upstash Redis (server-only — no VITE_ prefix)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (client-side)
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=

# Sentry (server-side)
SENTRY_DSN=
